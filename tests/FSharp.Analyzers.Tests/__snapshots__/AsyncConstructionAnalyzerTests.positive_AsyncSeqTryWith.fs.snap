[{"Code":"IDURA-ASYNC-001","Fixes":[],"Message":"This \u0027try\u0027 guards the construction of the asynchronous sequence, not its enumeration. Constructing the sequence runs none of the work: a fault is raised when an element is pulled, which happens outside this handler, so the handler never observes it. Enumerate the sequence inside the try, or handle faults where it is consumed.","Range":{"End":{"Line":21,"Column":22},"EndColumn":22,"EndLine":21,"FileName":"A.fs","Start":{"Line":18,"Column":4},"StartColumn":4,"StartLine":18},"Severity":{"Case":"Error"},"Type":"try guarding asynchronous construction"}]
