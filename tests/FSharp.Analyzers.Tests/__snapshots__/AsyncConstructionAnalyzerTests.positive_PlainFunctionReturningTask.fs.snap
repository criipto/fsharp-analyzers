[{"Code":"IDURA-ASYNC-001","Fixes":[],"Message":"This \u0027try\u0027 guards the construction of the asynchronous computation, not its execution. A fault raised while the computation runs is delivered when it is awaited so the handler never observes it. Await the computation inside the try or handle faults with a combinator such as TaskResult.catch.","Range":{"End":{"Line":12,"Column":24},"EndColumn":24,"EndLine":12,"FileName":"A.fs","Start":{"Line":10,"Column":4},"StartColumn":4,"StartLine":10},"Severity":{"Case":"Error"},"Type":"try guarding asynchronous construction"}]
