[{"Code":"IDURA-ASYNC-001","Fixes":[],"Message":"This \u0027try\u0027 guards the construction of the asynchronous computation, not its execution. A fault raised while the computation runs is delivered when it is awaited so the handler never observes it. Await the computation inside the try or handle faults with a combinator such as TaskResult.catch.","Range":{"End":{"Line":19,"Column":50},"EndColumn":50,"EndLine":19,"FileName":"A.fs","Start":{"Line":15,"Column":4},"StartColumn":4,"StartLine":15},"Severity":{"Case":"Error"},"Type":"try guarding asynchronous construction"},{"Code":"IDURA-ASYNC-001","Fixes":[],"Message":"This \u0027try\u0027 guards the construction of the asynchronous computation, not its execution. A fault raised while the computation runs is delivered when it is awaited so the handler never observes it. Await the computation inside the try or handle faults with a combinator such as TaskResult.catch.","Range":{"End":{"Line":28,"Column":34},"EndColumn":34,"EndLine":28,"FileName":"A.fs","Start":{"Line":24,"Column":4},"StartColumn":4,"StartLine":24},"Severity":{"Case":"Error"},"Type":"try guarding asynchronous construction"}]
