[{"Code":"IDURA-ASYNC-001","Fixes":[],"Message":"This \u0027try\u0027 guards the construction of the asynchronous computation, not its execution. A fault raised while the computation runs is delivered when it is awaited so the handler never observes it. Await the computation inside the try or handle faults with a combinator such as TaskResult.catch.","Range":{"End":{"Line":13,"Column":28},"EndColumn":28,"EndLine":13,"FileName":"A.fs","Start":{"Line":11,"Column":8},"StartColumn":8,"StartLine":11},"Severity":{"Case":"Error"},"Type":"try guarding asynchronous construction"}]
