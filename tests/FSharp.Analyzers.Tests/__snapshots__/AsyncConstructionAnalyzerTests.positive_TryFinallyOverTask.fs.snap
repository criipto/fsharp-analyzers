[{"Code":"IDURA-ASYNC-002","Fixes":[],"Message":"This \u0027finally\u0027 runs when the asynchronous computation is constructed and returned, not when it completes, so the cleanup happens while the computation is still running. Move the await inside the \u0027try\u0027 by making the body a computation expression (task { try ... return! ... finally ... }).","Range":{"End":{"Line":13,"Column":31},"EndColumn":31,"EndLine":13,"FileName":"A.fs","Start":{"Line":9,"Column":4},"StartColumn":4,"StartLine":9},"Severity":{"Case":"Error"},"Type":"resource disposed before the asynchronous computation completes"}]
