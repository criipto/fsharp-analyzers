[{"Code":"IDURA-ASYNC-002","Fixes":[],"Message":"This \u0027use\u0027 disposes \u0027cts\u0027 when the function returns the asynchronous computation, not when that computation completes. The computation still holds the resource while it runs, so it observes a disposed \u0027System.Threading.CancellationTokenSource\u0027. Move the await inside the scope by making the body a computation expression (task { ... return! ... }), so the \u0027use\u0027 spans execution rather than construction. Disposing a CancellationTokenSource does not cancel it. It releases the timer, so a deadline set with CancelAfter or the constructor overload silently never fires, and a library that registers on the token for a retry attempt gets an ObjectDisposedException.","Range":{"End":{"Line":13,"Column":66},"EndColumn":66,"EndLine":13,"FileName":"A.fs","Start":{"Line":13,"Column":4},"StartColumn":4,"StartLine":13},"Severity":{"Case":"Error"},"Type":"resource disposed before the asynchronous computation completes"},{"Code":"IDURA-ASYNC-002","Fixes":[],"Message":"This \u0027use\u0027 disposes \u0027stream\u0027 when the function returns the asynchronous computation, not when that computation completes. The computation still holds the resource while it runs, so it observes a disposed \u0027System.IO.FileStream\u0027. Move the await inside the scope by making the body a computation expression (task { ... return! ... }), so the \u0027use\u0027 spans execution rather than construction.","Range":{"End":{"Line":20,"Column":35},"EndColumn":35,"EndLine":20,"FileName":"A.fs","Start":{"Line":20,"Column":4},"StartColumn":4,"StartLine":20},"Severity":{"Case":"Error"},"Type":"resource disposed before the asynchronous computation completes"},{"Code":"IDURA-ASYNC-002","Fixes":[],"Message":"This \u0027use\u0027 disposes \u0027cts\u0027 when the function returns the asynchronous computation, not when that computation completes. The computation still holds the resource while it runs, so it observes a disposed \u0027System.Threading.CancellationTokenSource\u0027. Move the await inside the scope by making the body a computation expression (task { ... return! ... }), so the \u0027use\u0027 spans execution rather than construction. Disposing a CancellationTokenSource does not cancel it. It releases the timer, so a deadline set with CancelAfter or the constructor overload silently never fires, and a library that registers on the token for a retry attempt gets an ObjectDisposedException.","Range":{"End":{"Line":26,"Column":66},"EndColumn":66,"EndLine":26,"FileName":"A.fs","Start":{"Line":26,"Column":4},"StartColumn":4,"StartLine":26},"Severity":{"Case":"Error"},"Type":"resource disposed before the asynchronous computation completes"}]
