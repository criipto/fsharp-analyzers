[{"Code":"IDURA-ASYNC-002","Fixes":[],"Message":"This \u0027use\u0027 disposes \u0027cts\u0027 when the function returns the asynchronous computation, not when that computation completes. The computation still holds the resource while it runs, so it observes a disposed \u0027System.Threading.CancellationTokenSource\u0027. Move the await inside the scope by making the body a computation expression (task { ... return! ... }), so the \u0027use\u0027 spans execution rather than construction. Disposing a CancellationTokenSource does not cancel it. It releases the timer, so a deadline set with CancelAfter or the constructor overload silently never fires, and a library that registers on the token for a retry attempt gets an ObjectDisposedException.","Range":{"End":{"Line":15,"Column":66},"EndColumn":66,"EndLine":15,"FileName":"A.fs","Start":{"Line":15,"Column":4},"StartColumn":4,"StartLine":15},"Severity":{"Case":"Error"},"Type":"resource disposed before the asynchronous computation completes"}]
