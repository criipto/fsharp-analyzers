[{"Code":"IDURA-ASYNC-002","Fixes":[],"Message":"This \u0027use\u0027 disposes \u0027stream\u0027 when the function returns the asynchronous computation, not when that computation completes. The computation still holds the resource while it runs, so it observes a disposed \u0027System.IO.FileStream\u0027. Move the await inside the scope by making the body a computation expression (task { ... return! ... }), so the \u0027use\u0027 spans execution rather than construction.","Range":{"End":{"Line":13,"Column":39},"EndColumn":39,"EndLine":13,"FileName":"A.fs","Start":{"Line":13,"Column":8},"StartColumn":8,"StartLine":13},"Severity":{"Case":"Error"},"Type":"resource disposed before the asynchronous computation completes"}]
