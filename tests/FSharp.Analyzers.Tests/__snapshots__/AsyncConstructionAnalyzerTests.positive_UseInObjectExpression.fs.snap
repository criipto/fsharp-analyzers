[{"Code":"IDURA-ASYNC-002","Fixes":[],"Message":"This \u0027use\u0027 disposes \u0027stream\u0027 when the function returns the asynchronous computation, not when that computation completes. The computation still holds the resource while it runs, so it observes a disposed \u0027System.IO.FileStream\u0027. Move the await inside the scope by making the body a computation expression (task { ... return! ... }), so the \u0027use\u0027 spans execution rather than construction.","Range":{"End":{"Line":21,"Column":43},"EndColumn":43,"EndLine":21,"FileName":"A.fs","Start":{"Line":21,"Column":12},"StartColumn":12,"StartLine":21},"Severity":{"Case":"Error"},"Type":"resource disposed before the asynchronous computation completes"},{"Code":"IDURA-ASYNC-002","Fixes":[],"Message":"This \u0027use\u0027 disposes \u0027stream\u0027 when the function returns the asynchronous computation, not when that computation completes. The computation still holds the resource while it runs, so it observes a disposed \u0027System.IO.FileStream\u0027. Move the await inside the scope by making the body a computation expression (task { ... return! ... }), so the \u0027use\u0027 spans execution rather than construction.","Range":{"End":{"Line":26,"Column":45},"EndColumn":45,"EndLine":26,"FileName":"A.fs","Start":{"Line":26,"Column":14},"StartColumn":14,"StartLine":26},"Severity":{"Case":"Error"},"Type":"resource disposed before the asynchronous computation completes"}]
