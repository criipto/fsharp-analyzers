[{"Code":"IDURA-ASYNC-002","Fixes":[],"Message":"This \u0027use\u0027 disposes \u0027stream\u0027 when the function returns the asynchronous sequence, which is before a single element has been pulled from it: none of the work that needs the resource has run yet, so every element observes a disposed \u0027System.IO.FileStream\u0027. Move the enumeration inside the scope by making the body a computation expression (taskSeq { ... yield! ... }), so the \u0027use\u0027 spans enumeration rather than construction.","Range":{"End":{"Line":10,"Column":35},"EndColumn":35,"EndLine":10,"FileName":"A.fs","Start":{"Line":10,"Column":4},"StartColumn":4,"StartLine":10},"Severity":{"Case":"Error"},"Type":"resource disposed before the asynchronous computation completes"}]
